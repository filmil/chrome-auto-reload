{
  "manifest_version": 3,
  "name": "Auto Reload",
  "version": "0.1.0",
  "description": "Reloads a tab every N seconds, minutes or hours. No access to page content, no network.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Reload",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
